Preserve the conventional shell status when a tracee is terminated by a signal.
Without this assignment, a previously completed child can leave last_exit_status at
zero and make a later signal termination look successful.

--- a/src/tracee/event.c
+++ b/src/tracee/event.c
@@ -495,1 +495,2 @@
-	else if (WIFSIGNALED(tracee_status)) {
+	else if (WIFSIGNALED(tracee_status)) {
+		last_exit_status = 128 + WTERMSIG(tracee_status);
