From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nix-on-droid <nix-on-droid@local>
Date: Mon, 29 Sep 2026 00:00:00 +0000
Subject: [PATCH] build: let the environment own the optimization level

GNU make appends makefile `+=` flags after the environment's CFLAGS,
and GCC takes the last -O flag: the hardcoded -O2 silently downgraded
any environment -O3 (e.g. Nix's).  Keep -Wall -Wextra (the tree is
warning-aware) and let the packager choose -O.

---
 src/GNUmakefile |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/GNUmakefile b/src/GNUmakefile
index 5ade279..ead5164 100644
--- a/src/GNUmakefile
+++ b/src/GNUmakefile
@@ -15,7 +15,7 @@ OBJCOPY  ?= $(CROSS_COMPILE)objcopy
 OBJDUMP  ?= $(CROSS_COMPILE)objdump
 
 CPPFLAGS += -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE -I. -I$(VPATH)
-CFLAGS   += -Wall -Wextra -O2
+CFLAGS   += -Wall -Wextra
 LDFLAGS  += -ltalloc -Wl,-z,noexecstack
 ifdef PROOT_WITH_LIBANDROID_SHMEM
   CFLAGS += -DWITH_LIBANDROID_SHMEM
