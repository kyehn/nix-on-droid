From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nix-on-droid <nix-on-droid@local>
Date: Mon, 29 Sep 2026 00:00:00 +0000
Subject: [PATCH] syscall: support fchmodat2

Backport of proot-me/proot ea1551f, with the flags register corrected:
fchmodat2(dfd, path, mode, flags) carries its flags in the *fourth*
argument, so read SYSARG_4, not SYSARG_3.  Upstream reads mode by
mistake, and mode values such as 0644 contain the AT_SYMLINK_NOFOLLOW
bit (0x100), which would mistranslate a plain chmod as a symlink
operation.

With the flags in hand, AT_SYMLINK_NOFOLLOW can do what it promises:
translate the path as the link itself rather than its referent.

The per-arch syscall tables (452) come from
syscall-support-fchmodat2-sysnums.patch.

---
 src/syscall/enter.c      |    9 ++++++++-
 src/syscall/seccomp.c    |    1 +
 src/syscall/sysnums.list |    1 +
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index 6bfdd56..5d227e7 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -2539,17 +2539,24 @@ int translate_syscall_enter(Tracee *tracee)
 		break;
 
 	case PR_fchmodat:
+	case PR_fchmodat2:
 	case PR_faccessat:
 	case PR_faccessat2:
 	case PR_futimesat:
 	case PR_mknodat:
+		flags = syscall_number == PR_fchmodat2
+			? peek_reg(tracee, CURRENT, SYSARG_4)
+			: 0;
 		dirfd = peek_reg(tracee, CURRENT, SYSARG_1);
 
 		status = get_sysarg_path(tracee, path, SYSARG_2);
 		if (status < 0)
 			break;
 
-		status = translate_path2(tracee, dirfd, path, SYSARG_2, REGULAR);
+		if ((flags & AT_SYMLINK_NOFOLLOW) != 0)
+			status = translate_path2(tracee, dirfd, path, SYSARG_2, SYMLINK);
+		else
+			status = translate_path2(tracee, dirfd, path, SYSARG_2, REGULAR);
 		break;
 
 	case PR_inotify_add_watch:
diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index 198a2d1..1406e3a 100644
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -356,6 +356,7 @@ static FilteredSysnum proot_sysnums[] = {
 	{ PR_faccessat2,	FILTER_SYSEXIT },
 	{ PR_fchdir,		FILTER_SYSEXIT },
 	{ PR_fchmodat,		0 },
+	{ PR_fchmodat2,		0 },
 	{ PR_fchownat,		0 },
 	{ PR_fstatat64,		0 },
 	{ PR_futimesat,		0 },
diff --git a/src/syscall/sysnums.list b/src/syscall/sysnums.list
index d99e231..c221ddd 100644
--- a/src/syscall/sysnums.list
+++ b/src/syscall/sysnums.list
@@ -72,6 +72,7 @@ SYSNUM(fanotify_mark)
 SYSNUM(fchdir)
 SYSNUM(fchmod)
 SYSNUM(fchmodat)
+SYSNUM(fchmodat2)
 SYSNUM(fchown)
 SYSNUM(fchown32)
 SYSNUM(fchownat)
