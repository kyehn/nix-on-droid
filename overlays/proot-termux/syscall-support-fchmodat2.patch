From ee6f51b47bcafcc2bb5eb836b05d50a4e2fe1557 Mon Sep 17 00:00:00 2001
From: jane <jane@computer.local>
Date: Fri, 15 May 2026 10:20:26 +0000
Subject: [PATCH] syscall: support fchmodat2

---
 src/syscall/enter.c   | 4 ++++
 src/syscall/seccomp.c | 1 +
 src/syscall/sysnums.list | 1 +
 3 files changed, 6 insertions(+)

diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index 50f1543..04efdbe 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -438,10 +438,14 @@ int translate_syscall_enter(Tracee *tracee)
 		break;

 	case PR_fchmodat:
+	case PR_fchmodat2:
 	case PR_faccessat:
 	case PR_faccessat2:
 	case PR_futimesat:
 	case PR_mknodat:
+		flags = syscall_number == PR_fchmodat2
+			? peek_reg(tracee, CURRENT, SYSARG_3)
+			: 0;
 		dirfd = peek_reg(tracee, CURRENT, SYSARG_1);

 		status = get_sysarg_path(tracee, path, SYSARG_2);
diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index ee96143..433978e 100644
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -349,6 +349,7 @@ static FilteredSysnum proot_sysnums[] = {
 	{ PR_faccessat2,	FILTER_SYSEXIT },
 	{ PR_fchdir,		FILTER_SYSEXIT },
 	{ PR_fchmodat,		0 },
+	{ PR_fchmodat2,		0 },
 	{ PR_fchownat,		0 },
 	{ PR_fstatat64,		0 },
 	{ PR_futimesat,		0 },
diff --git a/src/syscall/sysnums.list b/src/syscall/sysnums.list
index 8170b6e..158373e 100644
--- a/src/syscall/sysnums.list
+++ b/src/syscall/sysnums.list
@@ -72,6 +72,7 @@ SYSNUM(fanotify_mark)
 SYSNUM(fchdir)
 SYSNUM(fchmod)
 SYSNUM(fchmodat)
+SYSNUM(fchmodat2)
 SYSNUM(fchown)
 SYSNUM(fchown32)
 SYSNUM(fchownat)
--
2.53.0
