diff --git a/src/android_compat.h b/src/android_compat.h
new file mode 100644
index 0000000..0ad33bc
--- /dev/null
+++ b/src/android_compat.h
@@ -0,0 +1,146 @@
+/* Helpers that issue only syscalls permitted by the Android untrusted_app
+ * seccomp policy inherited from zygote (SIGSYS-killing KILL action for
+ * legacy calls such as access, mkdir, unlink, fork, poll, dup2, ...).
+ * proot itself runs inside the app domain, so every libc wrapper that
+ * maps onto a blocked syscall must be replaced by its modern equivalent.
+ *
+ * Guest-side syscalls blocked by the same policy are handled separately,
+ * by the enter-stop rewrite in src/syscall/android_compat_syscalls.c. */
+
+#ifndef ANDROID_COMPAT_H
+#define ANDROID_COMPAT_H
+
+#include <errno.h>        /* errno, EEXIST, */
+#include <fcntl.h>        /* AT_FDCWD, AT_SYMLINK_NOFOLLOW, AT_REMOVEDIR, */
+#include <poll.h>         /* struct pollfd, */
+#include <signal.h>       /* SIGCHLD, */
+#include <string.h>       /* strlen, memcmp, */
+#include <sys/stat.h>     /* struct stat, mode_t, */
+#include <sys/syscall.h>  /* SYS_*, */
+#include <sys/types.h>    /* pid_t, */
+#include <time.h>         /* struct timespec, CLOCK_REALTIME, */
+#include <unistd.h>       /* syscall(2), */
+
+static inline int ac_faccessat(const char *path, int mode)
+{
+	return syscall(SYS_faccessat, AT_FDCWD, path, mode);
+}
+
+static inline int ac_lstat(const char *path, struct stat *statl)
+{
+	return syscall(SYS_newfstatat, AT_FDCWD, path, statl,
+		       AT_SYMLINK_NOFOLLOW);
+}
+
+static inline int ac_mkdir(const char *path, mode_t mode)
+{
+	return syscall(SYS_mkdirat, AT_FDCWD, path, mode);
+}
+
+static inline int ac_unlink(const char *path)
+{
+	return syscall(SYS_unlinkat, AT_FDCWD, path, 0);
+}
+
+static inline int ac_rmdir(const char *path)
+{
+	return syscall(SYS_unlinkat, AT_FDCWD, path, AT_REMOVEDIR);
+}
+
+static inline pid_t ac_fork(void)
+{
+	return (pid_t) syscall(SYS_clone, SIGCHLD, 0, 0, 0, 0, 0);
+}
+
+static inline int ac_pipe(int pipefd[2])
+{
+	return syscall(SYS_pipe2, pipefd, 0);
+}
+
+static inline int ac_dup2(int oldfd, int newfd)
+{
+	return syscall(SYS_dup3, oldfd, newfd, 0);
+}
+
+static inline time_t ac_time(time_t *timeptr)
+{
+	struct timespec now;
+
+	if (syscall(SYS_clock_gettime, CLOCK_REALTIME, &now) != 0)
+		return (time_t) -1;
+	if (timeptr != 0)
+		*timeptr = now.tv_sec;
+	return now.tv_sec;
+}
+
+static inline int ac_poll(struct pollfd *fds, unsigned long count, int timeout)
+{
+	struct timespec limit;
+	struct timespec *limitp = 0;
+
+	if (timeout >= 0) {
+		limit.tv_sec = timeout / 1000;
+		limit.tv_nsec = (long) (timeout % 1000) * 1000000L;
+		limitp = &limit;
+	}
+	return syscall(SYS_ppoll, fds, count, limitp, 0);
+}
+
+static inline int ac_rename(const char *oldpath, const char *newpath)
+{
+	return syscall(SYS_renameat, AT_FDCWD, oldpath, AT_FDCWD, newpath);
+}
+
+static inline int ac_symlink(const char *target, const char *linkpath)
+{
+	return syscall(SYS_symlinkat, target, AT_FDCWD, linkpath);
+}
+
+static inline int ac_chmod(const char *path, mode_t mode)
+{
+	return syscall(SYS_fchmodat, AT_FDCWD, path, mode);
+}
+
+static inline int ac_accept(int sockfd)
+{
+	return syscall(SYS_accept4, sockfd, 0, 0, 0);
+}
+
+/* musl mkdtemp() builds on mkdir(2), which the filter kills; retry with
+ * randomised suffixes through mkdirat(2).  @tmpl must end in "XXXXXX". */
+static inline char *ac_mkdtemp(char *tmpl)
+{
+	static const char alphabet[] =
+		"abcdefghijklmnopqrstuvwxyz"
+		"ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+		"0123456789";
+	size_t length = strlen(tmpl);
+	int attempt;
+
+	if (length < 6 || memcmp(tmpl + length - 6, "XXXXXX", 6) != 0) {
+		errno = EINVAL;
+		return 0;
+	}
+
+	for (attempt = 0; attempt < 128; attempt++) {
+		unsigned long random_value;
+		char *suffix = tmpl + length - 6;
+		int i;
+
+		if (syscall(SYS_getrandom, &random_value,
+			    sizeof(random_value), 0) != sizeof(random_value))
+			return 0;
+		for (i = 0; i < 6; i++) {
+			*suffix++ = alphabet[random_value % 62];
+			random_value /= 62;
+		}
+		if (syscall(SYS_mkdirat, AT_FDCWD, tmpl, 0700) == 0)
+			return tmpl;
+		if (errno != EEXIST)
+			return 0;
+	}
+	errno = EEXIST;
+	return 0;
+}
+
+#endif
