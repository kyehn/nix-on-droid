+/* One (ifindex, family, address) record harvested from the host's
+ * RTM_GETADDR dump: everything the synthetic link / addr replies need
+ * when getifaddrs(3) itself is unavailable.  */
+struct host_addr_entry {
+	int ifindex;
+	uint8_t family;
+	uint8_t scope;
+	uint8_t prefixlen;
+	uint8_t addrlen;
+	uint8_t addr[16];
+	char   label[IFNAMSIZ];
+};
+
+#define MAX_HOST_ADDR_ENTRIES 64
+
+/**
+ * Enumerate the host's addresses without getifaddrs(3).  Android's
+ * untrusted_app SELinux policy denies bind() on a NETLINK_ROUTE socket
+ * and RTM_GETLINK dumps (nlmsg_readpriv), but still allows RTM_GETADDR
+ * dumps (nlmsg_read) and the classic SIOCGIF* ioctls.  getifaddrs(3)
+ * opens with RTM_GETLINK and therefore fails outright on such hosts,
+ * which would leave the synthetic replies loopback-only and make
+ * sandbox helpers like Nix's haveInternet() probe switch themselves
+ * into offline mode (1-second connect timeouts, no substituters).
+ *
+ * Ask for an RTM_GETADDR dump over an *unbound* socket instead -- the
+ * SELinux 'bind' denial only bites an explicit bind(2); the kernel
+ * autobinds on the first send and still services the dump, the same
+ * trick relay_route_dump() relies on for "ip route".  Returns the
+ * number of entries stored in @entries, or -1 when the host refuses
+ * this too (callers then keep their previous fallbacks).
+ */
+static int host_addr_entries(struct host_addr_entry *entries)
+{
+	struct {
+		struct nlmsghdr nlh;
+		struct rtgenmsg g;
+	} request;
+	struct sockaddr_nl sa;
+	struct timeval tv = { .tv_sec = 2, .tv_usec = 0 };
+	uint8_t buf[8192] __attribute__((aligned(8)));
+	int fd, count = 0;
+	bool done = false;
+
+	fd = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE);
+	if (fd < 0)
+		return -1;
+	(void) setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+	memset(&request, 0, sizeof(request));
+	request.nlh.nlmsg_len   = NLMSG_LENGTH(sizeof(request.g));
+	request.nlh.nlmsg_type  = RTM_GETADDR;
+	request.nlh.nlmsg_flags = NLM_F_REQUEST | NLM_F_DUMP;
+	request.nlh.nlmsg_seq   = 1;
+	request.g.rtgen_family  = AF_UNSPEC;
+
+	memset(&sa, 0, sizeof(sa));
+	sa.nl_family = AF_NETLINK;
+	if (sendto(fd, &request, request.nlh.nlmsg_len, 0,
+		   (struct sockaddr *) &sa, sizeof(sa)) < 0) {
+		close(fd);
+		return -1;
+	}
+
+	while (!done && count < MAX_HOST_ADDR_ENTRIES) {
+		ssize_t len = recv(fd, buf, sizeof(buf), 0);
+		struct nlmsghdr *h;
+		ssize_t left;
+
+		if (len <= 0)   /* timeout / error: partial results still count */
+			break;
+
+		left = len;
+		for (h = (struct nlmsghdr *) buf; NLMSG_OK(h, left);
+		     h = NLMSG_NEXT(h, left)) {
+			struct ifaddrmsg *ifa;
+			struct rtattr *rta;
+			size_t rtasize;
+			const uint8_t *local = NULL, *primary = NULL;
+			const uint8_t *addr;
+			size_t local_len = 0, primary_len = 0, addr_len;
+			char label[IFNAMSIZ];
+			int i;
+			bool dup;
+
+			if (h->nlmsg_type == NLMSG_DONE) {
+				done = true;
+				break;
+			}
+			if (h->nlmsg_type != RTM_NEWADDR)
+				continue;
+
+			ifa = NLMSG_DATA(h);
+			if (ifa->ifa_family != AF_INET &&
+			    ifa->ifa_family != AF_INET6)
+				continue;
+
+			label[0] = '\0';
+			rtasize = IFA_PAYLOAD(h);
+			for (rta = IFA_RTA(ifa); RTA_OK(rta, rtasize);
+			     rta = RTA_NEXT(rta, rtasize)) {
+				if (rta->rta_type == IFA_LOCAL) {
+					local = RTA_DATA(rta);
+					local_len = RTA_PAYLOAD(rta);
+				} else if (rta->rta_type == IFA_ADDRESS) {
+					primary = RTA_DATA(rta);
+					primary_len = RTA_PAYLOAD(rta);
+				} else if (rta->rta_type == IFA_LABEL) {
+					size_t n = RTA_PAYLOAD(rta);
+					if (n >= sizeof(label))
+						n = sizeof(label) - 1;
+					memcpy(label, RTA_DATA(rta), n);
+					label[n] = '\0';
+				}
+			}
+
+			/* IFA_LOCAL is the real address on IPv4; some
+			 * point-to-point records only carry IFA_ADDRESS.  */
+			addr = (local != NULL) ? local : primary;
+			addr_len = (local != NULL) ? local_len : primary_len;
+			if (addr == NULL)
+				continue;
+			if ((ifa->ifa_family == AF_INET && addr_len != 4) ||
+			    (ifa->ifa_family == AF_INET6 && addr_len != 16))
+				continue;
+
+			dup = false;
+			for (i = 0; i < count; i++)
+				if (entries[i].ifindex == (int) ifa->ifa_index &&
+				    entries[i].family == ifa->ifa_family &&
+				    entries[i].addrlen == addr_len &&
+				    memcmp(entries[i].addr, addr, addr_len) == 0)
+					dup = true;
+			if (dup)
+				continue;
+
+			entries[count].ifindex   = (int) ifa->ifa_index;
+			entries[count].family    = ifa->ifa_family;
+			entries[count].scope     = ifa->ifa_scope;
+			entries[count].prefixlen = ifa->ifa_prefixlen;
+			entries[count].addrlen   = (uint8_t) addr_len;
+			memcpy(entries[count].addr, addr, addr_len);
+			memcpy(entries[count].label, label, sizeof(entries[count].label));
+			count++;
+		}
+	}
+
+	close(fd);
+	return count;
+}
+
+/* Build RTM_NEWLINK messages from what host_addr_entries() harvested:
+ * one link per interface owning an address, named via SIOCGIFNAME (or
+ * the IPv4 IFA_LABEL) and detailed via SIOCGIFFLAGS / SIOCGIFMTU /
+ * SIOCGIFHWADDR on a plain AF_INET socket -- all of which Android's
+ * untrusted_app policy still permits.  Same contract as
+ * build_host_links() below: returns the new offset, stores the number
+ * of links built in @built.  */
+static size_t build_links_from_addr_dump(uint8_t *out, size_t max,
+					 uint32_t seq, uint32_t pid,
+					 const char *want_name,
+					 int want_index, bool dump,
+					 int *built)
+{
+	struct host_addr_entry entries[MAX_HOST_ADDR_ENTRIES];
+	int ifindexes[MAX_HOST_ADDR_ENTRIES];
+	int n, nidx = 0, i, j;
+	int sock;
+	size_t off = 0;
+
+	n = host_addr_entries(entries);
+	if (n <= 0)
+		return 0;
+
+	for (i = 0; i < n && nidx < MAX_HOST_ADDR_ENTRIES; i++) {
+		for (j = 0; j < nidx; j++)
+			if (ifindexes[j] == entries[i].ifindex)
+				break;
+		if (j == nidx)
+			ifindexes[nidx++] = entries[i].ifindex;
+	}
+
+	sock = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+
+	for (i = 0; i < nidx; i++) {
+		char name[IFNAMSIZ];
+		uint32_t ifflags = IFF_UP | IFF_RUNNING;
+		uint16_t iftype = ARPHRD_ETHER;
+		uint32_t mtu = 1500;
+		uint8_t  hwaddr[8] = { 0 };
+		uint8_t  hwlen = 0;
+		int ifindex = ifindexes[i];
+		struct ifreq ifr;
+
+		/* Real name first, IFA_LABEL (IPv4) second, and a stable
+		 * placeholder last so no reply ever carries an empty
+		 * IFLA_IFNAME.  */
+		name[0] = '\0';
+		if (sock >= 0) {
+			memset(&ifr, 0, sizeof(ifr));
+			ifr.ifr_ifindex = ifindex;
+			if (ioctl(sock, SIOCGIFNAME, &ifr) == 0) {
+				strncpy(name, ifr.ifr_name, IFNAMSIZ - 1);
+				name[IFNAMSIZ - 1] = '\0';
+			}
+		}
+		if (name[0] == '\0') {
+			for (j = 0; j < n; j++)
+				if (entries[j].ifindex == ifindex &&
+				    entries[j].label[0] != '\0') {
+					strncpy(name, entries[j].label, IFNAMSIZ - 1);
+					name[IFNAMSIZ - 1] = '\0';
+					break;
+				}
+		}
+		if (name[0] == '\0')
+			snprintf(name, sizeof(name), "if%d", ifindex);
+
+		if (!dump) {
+			if (want_name != NULL && want_name[0] != '\0') {
+				if (strcmp(want_name, name) != 0)
+					continue;
+			} else if (want_index > 0 && ifindex != want_index) {
+				continue;
+			}
+		}
+
+		if (sock >= 0) {
+			memset(&ifr, 0, sizeof(ifr));
+			strncpy(ifr.ifr_name, name, IFNAMSIZ - 1);
+			if (ioctl(sock, SIOCGIFFLAGS, &ifr) == 0)
+				ifflags = (uint32_t) ifr.ifr_flags;
+
+			memset(&ifr, 0, sizeof(ifr));
+			strncpy(ifr.ifr_name, name, IFNAMSIZ - 1);
+			if (ioctl(sock, SIOCGIFMTU, &ifr) == 0)
+				mtu = (uint32_t) ifr.ifr_mtu;
+
+			memset(&ifr, 0, sizeof(ifr));
+			strncpy(ifr.ifr_name, name, IFNAMSIZ - 1);
+			if (ioctl(sock, SIOCGIFHWADDR, &ifr) == 0 &&
+			    !(ifflags & IFF_LOOPBACK)) {
+				iftype = (uint16_t) ifr.ifr_hwaddr.sa_family;
+				memcpy(hwaddr, ifr.ifr_hwaddr.sa_data, 6);
+				hwlen = 6;
+			}
+		}
+		if (ifflags & IFF_LOOPBACK)
+			iftype = ARPHRD_LOOPBACK;
+
+		if (off + 256 > max)
+			break;
+		off = nl_build_link(out, off, max, seq, pid,
+				    dump ? NLM_F_MULTI : 0, ifindex, iftype,
+				    ifflags, mtu, name, hwaddr, hwlen);
+		(*built)++;
+		if (!dump)
+			break;
+	}
+
+	if (sock >= 0)
+		close(sock);
+	return off;
+}
